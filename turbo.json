{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**"],
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_APP_DEVELOPMENT_URL",
        "NEXT_PUBLIC_APP_PREVIEW_URL",
        "NEXT_PUBLIC_APP_PRODUCTION_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#format": {
      "cache": false
    }
  }
}
