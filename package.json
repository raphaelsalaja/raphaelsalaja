{
  "name": "@rs/portfolio",
  "version": "2025.0.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:website": "turbo run dev --filter=website",
    "dev:design": "turbo run dev --filter=@rs/design",
    "lint": "turbo lint",
    "build": "turbo build",
    "build:website": "turbo run build --filter=website",
    "build:design": "turbo run build --filter=@rs/design",
    "build:turbo": "turbo lint && turbo build && pnpm install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.5.0"
}
