{
  "name": "@rs/portfolio",
  "version": "2025.0.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:website": "turbo run dev --filter=website",
    "dev:design": "turbo run dev --filter=@rs/design",
    "dev:playground": "turbo run dev --filter=playground",
    "lint": "turbo lint",
    "build": "turbo build",
    "build:turbo": "turbo lint && turbo build && pnpm install",
    "publish-packages": "turbo run build lint && changeset version && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@changesets/cli": "^2.29.5",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.5.0",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next-mdx-remote": "^5.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  }
}
