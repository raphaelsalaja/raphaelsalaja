{
  "name": "@rs/vacuum",
  "version": "1.0.0",
  "description": "Configurable cleanup utility for monorepo projects",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vacuum": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cleanup",
    "monorepo",
    "build-tools",
    "utility"
  ],
  "author": "Raphael Salaja",
  "license": "MIT",
  "dependencies": {
    "glob": "^10.3.10",
    "chalk": "^5.3.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "5.8.3"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
